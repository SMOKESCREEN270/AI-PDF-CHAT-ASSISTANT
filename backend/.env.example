# Copy to .env and fill in your values
# Use the same values as POSTGRES_USER and POSTGRES_PASSWORD in the root .env.
POSTGRES_USER=pdf_assistant
POSTGRES_PASSWORD=change-this-before-shared-deployment
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/pdf_chat_assistant
JWT_SECRET_KEY=replace_with_a_long_random_string
# Must differ from JWT_SECRET_KEY
SESSION_SECRET_KEY=replace_with_a_different_long_random_string
# Comma-separated full origin URLs in production (no wildcards), e.g. https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Public URL used in password-reset and email-verification links.
FRONTEND_URL=http://localhost:5173
# SMTP is required for real password-reset and verification delivery.
# For local development, leave SMTP_HOST empty to keep test links in the response.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI PDF Chat Assistant
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
DEFAULT_GEMINI_API_KEY=your_default_free_tier_gemini_key_here
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
# Set to false only if no ClamAV daemon is reachable (e.g. single-container
# free-tier hosting). Uploads are rejected outright while this is true and
# ClamAV can't be reached, so don't leave it true without a scanner running.
MALWARE_SCAN_ENABLED=true
CLAMD_HOST=localhost
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=10
